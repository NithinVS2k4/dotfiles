{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$FF_POKEMON",
    "padding": {
      "top": 4,
      "left": 2
    },
    "width": 30,
    "height": 15
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": "ホスト",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "os",
      "key": "╭─",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "├─",
      "format": "{1} {2}",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "├─󰮯",
      "keyColor": "magenta"
    },
    {
      "type": "de",
      "key": "├─",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "├─",
      "keyColor": "magenta"
    },
    {
      "type": "lm",
      "key": "├─󰧨",
      "keyColor": "magenta"
    },
    {
      "type": "theme",
      "key": "├─󰉼",
      "keyColor": "magenta"
    },
    {
      "type": "sound",
      "key": "╰─",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "terminal",
      "key": "╭─",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "├─",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "╰─",
      "keyColor": "green"
    },
    "break",
    {
      "type": "host",
      "key": "╭─",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "├─󰍛",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "├─󰘚",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "├─󰍹",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "├─󰑭",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "╰─󰅐",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─  {#black} {#red} {#green} {#yellow} {#blue} {#magenta} {#cyan} {#white}",
      "outputColor": "blue"
    },
    {
      "type": "custom",
      "format": "├─  {#bright_black} {#bright_red} {#bright_green} {#bright_yellow} {#bright_blue} {#bright_magenta} {#bright_cyan} {#bright_white}{#reset_default}",
      "outputColor": "blue"
    },
    {
        "type": "command",
        "shell": "/bin/bash",
        "text": "python3 -c 'import os; n=os.path.basename(os.environ[\"FF_POKEMON\"]).replace(\".png\", \"\"); print(\"\\033[1;91m\" + \" \".join(w.capitalize() for w in n.split(\"-\")) + \"\\033[0m\")'",
        "key": "╰─󰐝",
        "keyColor": "blue",
        "format": "{result}"
    }
    // {
    //     "type": "command",
    //     "shell": "/bin/bash",
    //     "text": "python3 -c 'import os; n=os.path.basename(os.environ[\"FF_POKEMON\"]).replace(\".png\", \"\"); print(\" \".join(w.capitalize() for w in n.split(\"-\")))'",
    //     "key": "╰─󰨉",
    //     "keyColor": "blue",
    //     "outputColor": "blue",
    //     "format": "{result}"
    // }
  ]
}
